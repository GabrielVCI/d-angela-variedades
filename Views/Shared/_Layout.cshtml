    <div class="sidebar">
        <h2 class="logo">
            <img src="~/logoPrograma/stockioRd.png" alt="Logo" class="logo-image">
            
            </h2>
        <ul class="menu">
            <li><a asp-action="Index" asp-controller="Home"><i class="fas fa-tachometer-alt me-2"></i> Dashboard</a></li>
            <li><a asp-action="Index" asp-controller="Clientes"><i class="fas fa-user-friends me-2"></i> Clientes</a></li>
            <li><a asp-action="Productos" asp-controller="Productos"><i class="fas fa-box-open me-2"></i> Productos</a></li>
            <li><a asp-action="Index" asp-controller="Clientes"><i class="fas fa-chart-line me-2"></i> Ventas</a></li>
            <li><a asp-action="Index" asp-controller="Categorias"><i class="fas fa-tags me-2"></i> Categorías</a></li>
